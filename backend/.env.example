# Postgres with the `invoice` table (the API only reads from it)
DATABASE_URL=postgresql://user:password@localhost:5434/dbname
# An empty database for the evals' sample data (evals/data/invoice.sql). Never the real one:
# the evals drop and refill its `invoice` table.
TEST_DATABASE_URL=postgresql://user:password@localhost:5434/constella_test

OPENAI_API_KEY=
# Optional: leave unset for the Agents SDK's default model
# OPENAI_MODEL=
# Optional: 1 for the prompt-only agent, 2 for one agent with tools; unset for v3, the roles
# AGENT_VERSION=
# Optional: a smaller model for the router; unset for the same one as the other roles
# ROUTER_MODEL=
# Optional: the writer's model, for the campaigns' slogans; unset for gpt-5.6-luna
# WRITER_MODEL=
# Optional: 0 to answer without the scientist's chart (one model call fewer)
# CHARTS=

# Stops DeepEval sending anonymous usage data to PostHog
DEEPEVAL_TELEMETRY_OPT_OUT=1
