# Lint config for the API's queries (app/infra/sql). Like constella-data-platform's (trailing commas,
# explicit aliases, 2-space indents, 100 columns), except that keywords, functions, types and
# literals are upper case here. Names stay lower case.
[sqlfluff]
dialect = postgres
# The queries carry psycopg's named parameters, e.g. %(max_items)s.
templater = placeholder
rules = core
max_line_length = 100

[sqlfluff:templater:placeholder]
param_style = pyformat

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 2

[sqlfluff:layout:type:comma]
line_position = trailing

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit
